# Copy to .env in this folder (do not commit .env with real production passwords).
# Development-only example values below.

MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# SuperAdmin (Faz 1 seed). İlk girişte şifre değiştirme zorunlu (MustChangePassword).
SEED_ADMIN_EMAIL=admin@ulkuocaklari.local
SEED_ADMIN_PASSWORD=ChangeMe!SecurePass12

# Optional. Docker dışından /health için istek başlığı: X-Health-Key
# HEALTH_ACCESS_KEY=

# Google Maps JavaScript API anahtarı. Boşsa harita çökmez; kısa bir uyarı gösterilir.
# Anahtarı Google Cloud'da HTTP referrer ile kısıtlayın. Gerçek anahtarı repoya yazmayın.
# GOOGLE_MAPS_API_KEY=

# Optional additional users (uncomment to seed; same min. length / Identity rules):
# SEED_PROVINCE_ADMIN_EMAIL=iladmin@ulkuocaklari.local
# SEED_PROVINCE_ADMIN_PASSWORD=ChangeMe!SecurePass12
# SEED_EDITOR_EMAIL=editor@ulkuocaklari.local
# SEED_EDITOR_PASSWORD=ChangeMe!SecurePass12