@model UOM.Web.Models.NotFoundPageModel
@{
    ViewData["Title"] = "Sayfa bulunamadı";
    Layout = "_Layout";
}
<h1 class="h2">Sayfa bulunamadı</h1>
<p class="text-muted">Aradığınız sayfa yayından kaldırılmış veya hiç olmamış olabilir.</p>
<form method="get" action="/ara" class="mb-4" role="search">
    <label class="form-label" for="not-found-q">Sitede ara</label>
    <div class="input-group">
        <input class="form-control" id="not-found-q" name="q" type="search" maxlength="200" />
        <button class="btn btn-primary" type="submit">Ara</button>
    </div>
</form>
@if (Model.Upcoming.Count > 0)
{
    <h2 class="h5">Yaklaşan etkinlikler</h2>
    <ul>
    @foreach (var evt in Model.Upcoming)
    {
        <li><a asp-controller="Event" asp-action="Detail" asp-route-slug="@evt.Slug">@evt.Title</a></li>
    }
    </ul>
}
<p><a asp-controller="Home" asp-action="Index">Ana sayfaya dönün</a></p>
