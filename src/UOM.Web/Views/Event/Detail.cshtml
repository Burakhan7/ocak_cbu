@using UOM.Application.Formatting
@model UOM.Application.Features.Public.Models.EventDetailDto
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;
    ViewData["Description"] = string.IsNullOrWhiteSpace(Model.MetaDescription) ? Model.Summary : Model.MetaDescription;
    ViewData["Canonical"] = "/etkinlikler/" + Model.Slug;
    ViewData["OgImage"] = Model.CoverImageUrl;
    ViewData["OgType"] = "article";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Ana Sayfa", "/"),
        new("Etkinlikler", "/etkinlikler"),
        new(Model.Title, "/etkinlikler/" + Model.Slug),
    };
}
@section PageBanner {
    <partial name="_PageBanner" model="@(new PageBannerModel(Model.Title, Model.StartsAtUtc.ToLocalDisplay(), Model.CoverImageUrl, Model.CoverImageAlt ?? Model.Title, "page-banner--detail"))" />
}
<article class="event-detail reading-article">
    @if (!string.IsNullOrWhiteSpace(Model.Summary))
    {
        <p class="lead">@Model.Summary</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
    {
        <partial name="_DetailCover" model="@(new CoverImageModel(Model.CoverImageUrl, Model.CoverImageAlt ?? Model.Title, MediaId: Model.CoverImageId))" />
    }
    @if (Model.Venue is not null)
    {
        <p class="mb-3"><strong>Mekan:</strong> @Model.Venue.Name@if (!string.IsNullOrWhiteSpace(Model.Venue.Address)){<text> — @Model.Venue.Address</text>}</p>
        @if (Model.Venue.Latitude is double lat && Model.Venue.Longitude is double lng)
        {
            <partial name="_GoogleMap" model="@(new GoogleMapRequest {
                Size = "mini",
                Pins = new[] { new GoogleMapPin(Model.Venue.Name, lat, lng, Model.Venue.Address, null, null, null) }
            })" />
        }
    }
    <div class="content-body mb-4">@Html.Raw(Model.BodyHtml)</div>
    <partial name="_EventCta" model="Model" />
</article>