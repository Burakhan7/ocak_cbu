@model GuideDetailDto
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;
    ViewData["Description"] = string.IsNullOrWhiteSpace(Model.MetaDescription) ? Model.Summary : Model.MetaDescription;
    ViewData["Canonical"] = "/cbu/rehber/" + Model.Slug;
    ViewData["OgImage"] = Model.CoverImageUrl;
    ViewData["OgType"] = "article";
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Ana Sayfa", "/"),
        new("CBÜ", "/cbu"),
        new("Rehber", "/cbu/rehber"),
        new(Model.Title, "/cbu/rehber/" + Model.Slug),
    };
}
@section PageBanner {
    <partial name="_PageBanner" model="@(new PageBannerModel(Model.Title, Model.Summary, Model.CoverImageUrl, Model.CoverImageAlt ?? Model.Title, "page-banner--detail page-banner--cbu"))" />
}
<article class="reading-article">
    <p><a asp-action="Index">← Rehber listesi</a></p>
    <p class="text-muted small mb-3">
        <span class="badge text-bg-light">@Model.Category</span>
        @if (Model.LastReviewedAtUtc is { } r)
        {
            <span class="ms-2">Son güncelleme: @r.ToLocalDisplay()</span>
        }
    </p>
    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
    {
        <partial name="_DetailCover" model="@(new CoverImageModel(Model.CoverImageUrl, Model.CoverImageAlt ?? Model.Title, MediaId: Model.CoverImageId))" />
    }
    <div class="content-body">@Html.Raw(Model.BodyHtml)</div>
</article>