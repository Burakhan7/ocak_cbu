@model GuideDetailDto
@{
    ViewData["Title"] = Model.Title;
}
@section PageBanner {
    <partial name="_PageBanner" model="@(new PageBannerModel(Model.Title, Model.Summary, Model.CoverImageUrl, Model.CoverImageAlt ?? Model.Title, "page-banner--detail page-banner--cbu"))" />
}
<article>
    <p><a asp-action="Index">← Rehber listesi</a></p>
    <p class="text-muted small mb-3">
        <span class="badge text-bg-light">@Model.Category</span>
        @if (Model.LastReviewedAtUtc is { } r)
        {
            <span class="ms-2">Son güncelleme: @r.ToLocalDisplay()</span>
        }
    </p>
    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
    {
        <partial name="_DetailCover" model="@(new CoverImageModel(Model.CoverImageUrl, Model.CoverImageAlt ?? Model.Title))" />
    }
    <div class="content-body">@Html.Raw(Model.BodyHtml)</div>
</article>