@model NewsPost
@{ ViewData["Title"] = "Önizleme: " + Model.Title; Layout = "_Layout"; }
<article class="container py-4">
    <p class="text-muted small">Önizleme — noindex</p>
    <h1>@Model.Title</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Summary)) { <p class="lead">@Model.Summary</p> }
    <div>@Html.Raw(Model.BodyHtml)</div>
</article>