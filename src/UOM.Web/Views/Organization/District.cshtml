@model UOM.Application.Features.Public.Models.DistrictDetailDto
@{
    ViewData["Title"] = Model.Name;
    ViewData["Canonical"] = "/teskilat/" + Model.Slug;
    ViewData["Breadcrumbs"] = new BreadcrumbItem[]
    {
        new("Ana Sayfa", "/"),
        new("Teşkilat", "/teskilat"),
        new(Model.Name, "/teskilat/" + Model.Slug),
    };
}
@section PageBanner {
    <partial name="_PageBanner" model='new UOM.Web.Models.PageBannerModel(Model.Name, "İlçe teşkilatı", ModifierClass: "page-banner--detail")' />
}
<dl class="row mb-4">
    @if (!string.IsNullOrWhiteSpace(Model.PresidentName))
    {
        <dt class="col-sm-3">İlçe başkanı</dt>
        <dd class="col-sm-9">@Model.PresidentName</dd>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Address))
    {
        <dt class="col-sm-3">Adres</dt>
        <dd class="col-sm-9">@Model.Address</dd>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Phone))
    {
        <dt class="col-sm-3">Telefon</dt>
        <dd class="col-sm-9"><a href="tel:@Model.Phone">@Model.Phone</a></dd>
    }
</dl>
@if (Model.Latitude is { } lat && Model.Longitude is { } lng)
{
    <p>
        <a class="btn btn-outline-primary btn-sm" href="https://www.google.com/maps/dir/?api=1&amp;destination=@lat.ToString(System.Globalization.CultureInfo.InvariantCulture),@lng.ToString(System.Globalization.CultureInfo.InvariantCulture)" rel="noopener noreferrer" target="_blank">Yol tarifi al</a>
    </p>
    <div id="district-map" class="rounded border" style="height: 280px;"></div>
    @section Scripts {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script>
            (function () {
                var map = L.map('district-map').setView([@lat.ToString(System.Globalization.CultureInfo.InvariantCulture), @lng.ToString(System.Globalization.CultureInfo.InvariantCulture)], 14);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);
                L.marker([@lat.ToString(System.Globalization.CultureInfo.InvariantCulture), @lng.ToString(System.Globalization.CultureInfo.InvariantCulture)]).addTo(map);
            })();
        </script>
    }
}
<p class="mt-3"><a asp-action="Index">← Teşkilat</a></p>