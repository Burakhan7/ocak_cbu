@using UOM.Application.Features.Public.Models
@model IReadOnlyList<NewsListItemDto>
<section class="py-4 home-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Haberler</h2>
        <a asp-controller="News" asp-action="Index">Tüm haberler</a>
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted">Yayınlanmış haber bulunmuyor.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <article class="card h-100 content-card">
                        <partial name="_CardCover" model="@(new CoverImageModel(item.CoverImageUrl, item.CoverImageAlt ?? item.Title))" />
                        <div class="card-body">
                            <span class="badge text-bg-light mb-2">@item.Scope</span>
                            <h3 class="h6"><a asp-controller="News" asp-action="Detail" asp-route-slug="@item.Slug" class="stretched-link text-decoration-none">@item.Title</a></h3>
                            <p class="small text-muted mb-0">@item.Summary</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>