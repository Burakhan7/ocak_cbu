@using UOM.Application.Features.Public.Models
@model IReadOnlyList<HomeFeedCardDto>
<section class="py-4 home-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Haberler</h2>
        <a asp-controller="News" asp-action="Index">Tüm haberler</a>
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted">Yayınlanmış haber bulunmuyor.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <article class="card h-100 content-card">
                        <partial name="_CardCover" model="@(new CoverImageModel(item.ImageUrl, item.ImageAlt ?? item.Title))" />
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(item.Badge))
                            {
                                <span class="badge text-bg-light mb-2">@item.Badge</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ExternalUrl))
                            {
                                <h3 class="h6">@item.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(item.WhenText))
                                {
                                    <p class="small text-muted mb-1">@item.WhenText</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Summary))
                                {
                                    <p class="small text-muted mb-2">@item.Summary</p>
                                }
                                <a class="small stretched-link" href="@item.ExternalUrl" rel="noopener noreferrer" target="_blank">Ana sitede oku ↗</a>
                            }
                            else
                            {
                                <h3 class="h6"><a href="@item.LocalPath" class="stretched-link text-decoration-none">@item.Title</a></h3>
                                @if (!string.IsNullOrWhiteSpace(item.WhenText))
                                {
                                    <p class="small text-muted mb-1">@item.WhenText</p>
                                }
                                <p class="small text-muted mb-0">@item.Summary</p>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
