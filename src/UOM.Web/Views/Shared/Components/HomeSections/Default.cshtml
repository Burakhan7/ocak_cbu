@using UOM.Application.Features.Public
@model IReadOnlyList<string>
@foreach (var section in Model)
{
    switch (section)
    {
        case HomeSectionIds.Hero:
            @await Component.InvokeAsync("HeroSection");
            break;
        case HomeSectionIds.QuoteBand:
            @await Component.InvokeAsync("QuoteBand")
            break;
        case HomeSectionIds.CbuQuickLinks:
            @await Component.InvokeAsync("CbuHubHome")
            break;
        case HomeSectionIds.UpcomingEvents:
            @await Component.InvokeAsync("UpcomingEventsSection");
            break;
        case HomeSectionIds.News:
            @await Component.InvokeAsync("NewsHomeSection");
            break;
        case HomeSectionIds.ParentNews:
            @await Component.InvokeAsync("ParentNewsStrip")
            break;
        case HomeSectionIds.Projects:
            @await Component.InvokeAsync("ParentProjectsSection")
            break;
        case HomeSectionIds.MagazineVideo:
            @await Component.InvokeAsync("MagazineVideoSection")
            break;
        case HomeSectionIds.VisitUs:
            @await Component.InvokeAsync("VisitUsSection");
            break;
    }
}