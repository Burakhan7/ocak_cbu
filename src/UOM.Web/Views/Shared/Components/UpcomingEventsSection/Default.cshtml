@model IReadOnlyList<UOM.Application.Features.Public.Models.HomeFeedCardDto>
<section class="py-4 home-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Yaklaşan etkinlikler</h2>
        <a asp-controller="Event" asp-action="Index">Tüm etkinlikler</a>
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted">Henüz yayınlanmış yaklaşan etkinlik yok.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var evt in Model)
            {
                <div class="col-md-4">
                    <article class="card h-100 content-card">
                        <partial name="_CardCover" model="@(new CoverImageModel(evt.ImageUrl, evt.ImageAlt ?? evt.Title))" />
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(evt.Badge))
                            {
                                <span class="badge text-bg-light mb-2">@evt.Badge</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(evt.ExternalUrl))
                            {
                                <h3 class="h6">@evt.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(evt.WhenText))
                                {
                                    <p class="small text-muted mb-2">@evt.WhenText</p>
                                }
                                <a class="small stretched-link" href="@evt.ExternalUrl" rel="noopener noreferrer" target="_blank">Ana sitede oku ↗</a>
                            }
                            else
                            {
                                <h3 class="h6"><a href="@evt.LocalPath" class="stretched-link text-decoration-none">@evt.Title</a></h3>
                                <p class="small text-muted mb-0">@evt.WhenText</p>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
