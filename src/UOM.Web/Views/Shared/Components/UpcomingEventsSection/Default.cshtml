@using UOM.Application.Formatting
@using UOM.Application.Features.Public.Models
@model IReadOnlyList<EventListItemDto>
<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Yaklaşan etkinlikler</h2>
        <a asp-controller="Event" asp-action="Index">Tüm etkinlikler</a>
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted">Henüz yayınlanmış yaklaşan etkinlik yok.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var evt in Model)
            {
                <div class="col-md-4">
                    <article class="card h-100">
                        <div class="card-body">
                            <h3 class="h6"><a asp-controller="Event" asp-action="Detail" asp-route-slug="@evt.Slug" class="stretched-link text-decoration-none">@evt.Title</a></h3>
                            <p class="small text-muted mb-0">@evt.StartsAtUtc.ToLocalDisplay()</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>