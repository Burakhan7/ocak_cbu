<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <seo-meta />
    <json-ld />
    <link rel="alternate" type="application/rss+xml" title="Haberler" href="/feed.xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UOM.Web.styles.css" asp-append-version="true" />
</head>
<body class="public-site">
    <div class="reading-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Okuma ilerlemesi">
        <span class="reading-progress__bar"></span>
    </div>
@await Component.InvokeAsync("PublicLayout")
    <header class="site-header">
        <div class="container d-flex align-items-center justify-content-between py-2" style="max-width: var(--container-max);">
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrWhiteSpace(ViewBag.SiteLogoUrl as string))
                {
                    <img src="@ViewBag.SiteLogoUrl" alt="@(ViewBag.SiteName ?? "Ülkü Ocakları Manisa")" height="40" width="auto" class="site-brand-logo" />
                }
                else
                {
                    <span class="site-brand-title">@(ViewBag.SiteName ?? "Ülkü Ocakları Manisa")</span>
                }
            </a>
            <nav class="d-none d-md-flex gap-3 align-items-center public-nav" aria-label="Ana menü">
                <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                <a asp-controller="Campus" asp-action="Index">CBÜ</a>
                <a asp-controller="Event" asp-action="Index">Etkinlikler</a>
                <a asp-controller="News" asp-action="Index">Haberler</a>
                <a asp-controller="Parent" asp-action="Index">Genel Merkez</a>
                <a asp-controller="Organization" asp-action="Index">Teşkilat</a>
                <a asp-controller="Contact" asp-action="Index">İletişim</a>
                @if (ViewBag.SearchEnabled is not false)
                {
                    <a href="/ara">Ara</a>
                }
            </nav>
            @if (ViewBag.SearchEnabled is not false)
            {
                <a class="btn btn-link btn-sm d-md-none" href="/ara">Ara</a>
            }
            <a class="btn btn-primary btn-sm ocağa-ugra-btn" asp-controller="Contact" asp-action="Index" asp-fragment="harita">Ocağa Uğra</a>
        </div>
    </header>

    <main class="site-main pb-5">
        @await RenderSectionAsync("PageBanner", required: false)
        <div class="site-main__content container" style="max-width: var(--container-max);">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer border-top mt-auto">
        <div class="container py-4" style="max-width: var(--container-max);">
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>@(ViewBag.SiteName ?? "Ülkü Ocakları Manisa")</strong>
                    <p class="small text-muted mb-0">@(ViewBag.SiteAddress)</p>
                </div>
                <div class="col-md-4">
                    <strong>Hızlı bağlantılar</strong>
                    <ul class="list-unstyled small mb-0">
                        @if (ViewBag.FooterPages is IEnumerable<UOM.Application.Features.Public.Models.StaticPageLinkDto> footerPages)
                        {
                            foreach (var link in footerPages)
                            {
                                <li><a asp-controller="Page" asp-action="Detail" asp-route-slug="@link.Slug">@link.Title</a></li>
                            }
                        }
                    </ul>
                </div>
                <div class="col-md-4">
                    <strong>Genel Merkez</strong>
                    <p class="small mb-0"><a href="https://ulkuocaklari.org.tr" rel="noopener" target="_blank">ulkuocaklari.org.tr ↗</a></p>
                    <p class="small text-muted mb-0">Ülkü Ocakları Eğitim ve Kültür Vakfı</p>
                </div>
            </div>
            <p class="small text-muted mb-0 mt-3">© @DateTime.UtcNow.Year Ülkü Ocakları Manisa İl Başkanlığı</p>
        </div>
    </footer>

    <nav class="mobile-tabbar d-md-none" aria-label="Mobil kısayollar">
        <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
        <a asp-controller="Campus" asp-action="Index">CBÜ</a>
        <a asp-controller="Event" asp-action="Index">Etkinlikler</a>
        <a asp-controller="Contact" asp-action="Index" asp-fragment="harita">Ocağa Uğra</a>
    </nav>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/quote-band.js" asp-append-version="true"></script>
    <script src="~/js/youtube-lite.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>