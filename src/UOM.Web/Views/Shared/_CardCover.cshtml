@model UOM.Web.Models.CoverImageModel
<div class="card-cover @Model.ModifierClass">
    @if (!string.IsNullOrWhiteSpace(Model.Url))
    {
        <img src="@Model.Url" alt="@Model.Alt" class="card-cover__img" loading="lazy" decoding="async" />
    }
    else
    {
        <div class="card-cover__placeholder" role="img" aria-label="@Model.Alt — görsel yok"></div>
    }
</div>