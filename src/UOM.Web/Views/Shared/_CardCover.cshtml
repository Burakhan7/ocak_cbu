@model UOM.Web.Models.CoverImageModel
<div class="card-cover @Model.ModifierClass">
    @if (Model.MediaId is int mediaId && mediaId > 0)
    {
        <responsive-image media-id="@mediaId" src="@Model.Url" alt="@Model.Alt" class="card-cover__img" sizes="@(Model.Sizes ?? "(min-width: 992px) 360px, (min-width: 768px) 50vw, 100vw")" loading="lazy" />
    }
    else if (!string.IsNullOrWhiteSpace(Model.Url))
    {
        <img src="@Model.Url" alt="@Model.Alt" class="card-cover__img" loading="lazy" decoding="async" />
    }
    else
    {
        <div class="card-cover__placeholder" role="img" aria-label="@Model.Alt — görsel yok"></div>
    }
</div>
