@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.Options
@using UOM.Application.Features.Public
@using UOM.Web.Configuration
@model UOM.Web.Models.GoogleMapRequest
@inject IOptions<GoogleMapsOptions> MapsOptions
@{
    var key = MapsOptions.Value.ApiKey?.Trim();
    var pins = Model.Pins.Where(pin => MapViewportMath.IsUsable(pin.Latitude, pin.Longitude)).ToList();
    var hasPins = pins.Count > 0;
    var showMap = Model.Picker || hasPins;
    var sizeClass = Model.Size switch
    {
        "mini" => "uom-map uom-map--mini",
        "tall" => "uom-map uom-map--tall",
        _ => "uom-map",
    };
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    string? latText = null;
    string? lngText = null;
    var coordText = "Henüz konum seçilmedi.";
    if (Model.Latitude is double mapLat && Model.Longitude is double mapLng && MapViewportMath.IsUsable(mapLat, mapLng))
    {
        latText = mapLat.ToString(CultureInfo.InvariantCulture);
        lngText = mapLng.ToString(CultureInfo.InvariantCulture);
        coordText = $"Seçilen konum: {mapLat.ToString("0.######", tr)}, {mapLng.ToString("0.######", tr)}";
    }
    var pinsJson = JsonSerializer.Serialize(pins.Select(pin => new
    {
        title = pin.Title,
        lat = pin.Latitude,
        lng = pin.Longitude,
        line1 = pin.Line1,
        line2 = pin.Line2,
        href = pin.Href,
        linkLabel = pin.LinkLabel,
    }));
}
@if (!showMap && Model.AnnounceEmpty)
{
    <p class="uom-map-notice text-muted small">Haritada gösterilecek konum yok.</p>
}
else if (showMap && string.IsNullOrWhiteSpace(key))
{
    <div class="alert alert-warning uom-map-notice" role="status">Google Haritalar anahtarı tanımlı değil. Harita gösterilemiyor.</div>
}
else if (showMap)
{
    <div class="uom-map-block mb-3">
        @if (Model.Picker)
        {
            <p class="small text-muted mb-2">Konumu seçmek için haritaya tıklayın.</p>
        }
        <div class="@sizeClass"
             data-uom-map
             data-mode="@(Model.Picker ? "picker" : "display")"
             data-api-key="@key"
             data-pins="@pinsJson"
             data-lat-field="@Model.LatFieldId"
             data-lng-field="@Model.LngFieldId"
             data-lat="@latText"
             data-lng="@lngText"
             role="region"
             aria-label="Harita"></div>
        @if (Model.Picker)
        {
            <p class="small text-muted mt-2 mb-0" data-uom-coord>@coordText</p>
        }
    </div>
    <script src="~/js/map-viewport.js" asp-append-version="true"></script>
    <script src="~/js/google-maps.js" asp-append-version="true"></script>
}
