@model NewsPost
@using Microsoft.AspNetCore.Authorization
@using UOM.Application.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni haber" : "Haber düzenle";
    var canPublish = (await AuthorizationService.AuthorizeAsync(User, PolicyNames.CanPublish)).Succeeded;
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
@if (!string.IsNullOrWhiteSpace(Model.LastRejectionNote))
{
    <div class="alert alert-warning">Son red notu: @Model.LastRejectionNote</div>
}
<form method="post" asp-action="Save" asp-controller="NewsPosts" asp-area="Admin">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Slug" />
    <input type="hidden" asp-for="Status" />
    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label">Başlık</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Kapsam</label>
            <select asp-for="Scope" class="form-select" asp-items="Html.GetEnumSelectList<NewsScope>()"></select>
        </div>
        <div class="col-12">
            <label class="form-label">Özet</label>
            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-12">
            <label class="form-label">Gövde</label>
            @{ ViewData["FieldName"] = "BodyHtml"; ViewData["FieldId"] = "news-body"; }
            <partial name="_RichTextEditor" model="Model.BodyHtml" />
        </div>
    </div>
    <div class="mt-3 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        @if (Model.Id > 0)
        {
            <button formaction="@Url.Action("Submit", new { id = Model.Id })" formmethod="post" class="btn btn-outline-secondary" type="submit">Onaya gönder</button>
            <a class="btn btn-outline-info" href="@Url.Action("PreviewLink", new { id = Model.Id })">Önizleme linki</a>
            if (canPublish)
            {
                <button formaction="@Url.Action("Publish", new { id = Model.Id })" formmethod="post" class="btn btn-success" type="submit">Yayınla</button>
            }
        }
    </div>
</form>
@if (Model.Id > 0 && canPublish && Model.Status == PublishStatus.PendingApproval)
{
    <form method="post" asp-action="Reject" asp-route-id="@Model.Id" class="mt-3 card card-body">
        <label class="form-label">Red notu</label>
        <textarea name="rejectionNote" class="form-control" required rows="2"></textarea>
        <button type="submit" class="btn btn-outline-danger mt-2">Reddet</button>
    </form>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}