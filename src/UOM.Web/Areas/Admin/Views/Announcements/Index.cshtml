@model IReadOnlyList<Announcement>
@{ ViewData["Title"] = "Duyurular"; }
<h1 class="h3 mb-3">Duyurular</h1>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni duyuru</a>
<ul class="list-group">
@foreach (var a in Model)
{
    <li class="list-group-item d-flex justify-content-between">
        <span>@a.Title <small class="text-muted">@a.Status · bitiş @a.ExpiresAtUtc.ToLocalTime().ToString("d")</small></span>
        <a asp-action="Edit" asp-route-id="@a.Id">Düzenle</a>
    </li>
}
</ul>