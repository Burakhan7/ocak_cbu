@model IReadOnlyList<Event>
@{
    ViewData["Title"] = "Etkinlikler";
}
<div class="d-flex justify-content-between mb-3">
    <h1 class="h3">Etkinlikler</h1>
    <a class="btn btn-primary" asp-action="Create">Yeni etkinlik</a>
</div>
<table class="table table-sm bg-white">
    <thead><tr><th>Başlık</th><th>Başlangıç (UTC)</th><th>Durum</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Title</td>
            <td>@e.StartsAtUtc.ToString("g")</td>
            <td>@e.Status</td>
            <td><a asp-action="Edit" asp-route-id="@e.Id">Düzenle</a></td>
        </tr>
    }
    </tbody>
</table>