@model Event
@using Microsoft.AspNetCore.Authorization
@using UOM.Application.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni etkinlik" : "Etkinlik düzenle";
    var canPublish = (await AuthorizationService.AuthorizeAsync(User, PolicyNames.CanPublish)).Succeeded;
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<form method="post" asp-action="Save" asp-controller="Events" asp-area="Admin" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Status" />
    <input type="hidden" asp-for="CoverImageId" />
    <partial name="_AdminCoverImageField" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label">Başlık</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Slug" class="form-label">Adres (slug)</label>
        <input asp-for="Slug" class="form-control" />
        <div class="form-text">Yayındaki adres değişirse eski adres yeni adrese yönlendirilir.</div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="StartsAtUtc" class="form-label">Başlangıç (UTC)</label>
            <input asp-for="StartsAtUtc" class="form-control" type="datetime-local"
                   value="@Model.StartsAtUtc.ToString("yyyy-MM-ddTHH:mm")" />
        </div>
        <div class="col-md-4">
            <label asp-for="VenueId" class="form-label">Mekan</label>
            <select asp-for="VenueId" class="form-select" asp-items="ViewBag.Venues">
                <option value="">—</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Type" class="form-label">Tür</label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<EventType>()"></select>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Gövde</label>
        @{ ViewData["FieldName"] = "BodyHtml"; ViewData["FieldId"] = "event-body"; }
        <partial name="_RichTextEditor" model="Model.BodyHtml" />
    </div>
    <details class="mb-3">
        <summary>SEO</summary>
        <div class="mt-2">
            <label class="form-label" asp-for="MetaTitle">Meta başlık</label>
            <input asp-for="MetaTitle" class="form-control" maxlength="60" />
        </div>
        <div class="mt-2">
            <label class="form-label" asp-for="MetaDescription">Meta açıklama</label>
            <textarea asp-for="MetaDescription" class="form-control" maxlength="160" rows="2"></textarea>
            <div class="form-text">OG görseli kapak görselidir.</div>
        </div>
    </details>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    @if (Model.Id > 0)
    {
        <button formaction="@Url.Action("Submit", new { id = Model.Id })" formmethod="post" class="btn btn-outline-secondary" type="submit">Onaya gönder</button>
        if (canPublish)
        {
            <button formaction="@Url.Action("Publish", new { id = Model.Id })" formmethod="post" class="btn btn-success" type="submit">Yayınla</button>
        }
    }
</form>