@model IReadOnlyList<Venue>
@{ ViewData["Title"] = "Mekanlar"; }
<h1 class="h3 mb-3">Mekanlar</h1>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni mekan</a>
<ul class="list-group">
@foreach (var v in Model)
{
    <li class="list-group-item d-flex justify-content-between">
        <span>@v.Name</span>
        <span>
            <a asp-action="Edit" asp-route-id="@v.Id">Düzenle</a>
            <partial name="_AdminDeleteForm" model="v.Id" />
        </span>
    </li>
}
</ul>