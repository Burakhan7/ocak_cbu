@model int
<form asp-action="Delete" asp-route-id="@Model" method="post" class="d-inline ms-2">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-link btn-sm text-danger p-0 align-baseline" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</button>
</form>