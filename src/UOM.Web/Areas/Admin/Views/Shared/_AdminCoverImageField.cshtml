@{
    var previewUrl = ViewData["CoverImagePreviewUrl"] as string;
    var altText = ViewData["CoverImageAltText"] as string;
}
<div class="card card-body mb-3">
    <h2 class="h6 mb-3">Kapak görseli</h2>
    @if (!string.IsNullOrWhiteSpace(previewUrl))
    {
        <img src="@previewUrl" alt="@(altText ?? "Mevcut kapak görseli")" class="img-thumbnail mb-2" style="max-height: 160px;" />
    }
    <div class="mb-2">
        <label for="coverImageUpload" class="form-label">Yeni görsel yükle</label>
        <input type="file" class="form-control" id="coverImageUpload" name="coverImageUpload" accept="image/jpeg,image/png,image/webp" />
        <div class="form-text text-muted">JPEG, PNG veya WebP — en fazla 10 MB</div>
    </div>
    <div class="mb-2">
        <label for="coverImageAlt" class="form-label">Alt metin (yükleme yapıyorsanız)</label>
        <input type="text" class="form-control" id="coverImageAlt" name="coverImageAlt" value="@altText" maxlength="300" />
    </div>
    <div class="form-check">
        <input type="checkbox" class="form-check-input" id="removeCoverImage" name="removeCoverImage" value="true" />
        <label class="form-check-label" for="removeCoverImage">Görseli kaldır</label>
    </div>
</div>