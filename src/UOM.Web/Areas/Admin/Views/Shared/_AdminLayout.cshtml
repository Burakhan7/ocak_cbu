<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Yönetim</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="bg-light">
<header class="border-bottom bg-white mb-4 admin-header">
    <nav class="navbar navbar-expand-lg container admin-navbar">
        <a class="navbar-brand flex-shrink-0" href="/yonetim">Ülkü Ocakları Manisa — Yönetim</a>
        <div class="admin-nav-scroll ms-lg-auto">
        <div class="navbar-nav flex-row flex-nowrap">
            <a class="nav-link" href="/yonetim/haberler">Haberler</a>
            <a class="nav-link" href="/yonetim/etkinlikler">Etkinlikler</a>
            <a class="nav-link" href="/yonetim/rehber">CBÜ Rehber</a>
            <a class="nav-link" href="/yonetim/kaynaklar">Kaynaklar</a>
            <a class="nav-link" href="/yonetim/duyurular">Duyurular</a>
            <a class="nav-link" href="/yonetim/kampusler">Kampüsler</a>
            <a class="nav-link" href="/yonetim/alintilar">Alıntılar</a>
            <a class="nav-link" href="/yonetim/genel-merkez-haberleri">GM Haber</a>
            <a class="nav-link" href="/yonetim/projeler">Projeler</a>
            <a class="nav-link" href="/yonetim/dergiler">Dergiler</a>
            <a class="nav-link" href="/yonetim/videolar">Videolar</a>
            <a class="nav-link" href="/yonetim/il-yonetimi">İl yönetimi</a>
            <a class="nav-link" href="/yonetim/ilceler">İlçeler</a>
            <a class="nav-link" href="/yonetim/mekanlar">Mekanlar</a>
            <a class="nav-link" href="/yonetim/medya">Medya</a>
            <a class="nav-link" href="/yonetim/site-ayarlari">Site Ayarları</a>
            <form method="post" action="/yonetim/hesap/cikis" class="d-inline ms-3 flex-shrink-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link nav-link text-nowrap">Çıkış</button>
            </form>
        </div>
        </div>
    </nav>
</header>
<main class="container pb-5">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (TempData["PreviewUrl"] is string previewUrl)
    {
        <div class="alert alert-info">Önizleme (24 saat): <a href="@previewUrl" target="_blank" rel="noopener">@previewUrl</a></div>
    }
    @RenderBody()
</main>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>