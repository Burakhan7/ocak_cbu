@model IReadOnlyList<UOM.Domain.Entities.Quote>
@{ ViewData["Title"] = "Alıntılar"; }
<h1 class="h3 mb-3">Alıntılar</h1>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni alıntı</a>
<ul class="list-group">
@foreach (var q in Model)
{
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <span>@(q.Text.Length > 80 ? q.Text[..80] + "…" : q.Text) <small class="text-muted">@q.Author @(q.IsActive ? "" : "· pasif")</small></span>
        <span>
            <a asp-action="Edit" asp-route-id="@q.Id">Düzenle</a>
            <partial name="_AdminDeleteForm" model="q.Id" />
        </span>
    </li>
}
</ul>