@model IReadOnlyList<MediaFile>
@using System.Text.Json
@{ ViewData["Title"] = "Medya kütüphanesi"; }
<h1 class="h3 mb-3">Medya kütüphanesi</h1>
<form method="post" asp-action="Upload" enctype="multipart/form-data" class="card card-body mb-4">
    <div class="mb-3">
        <label class="form-label">Görsel</label>
        <input type="file" name="file" accept="image/*" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Alt metin</label>
        <input name="altText" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Yükle</button>
</form>
<div class="row g-3">
@foreach (var m in Model)
{
    var variants = string.IsNullOrWhiteSpace(m.Variants) ? null : JsonSerializer.Deserialize<Dictionary<string,string>>(m.Variants);
    <div class="col-md-4">
        <div class="admin-card">
            <p class="small mb-1">@m.OriginalFileName</p>
            <p class="small text-muted">@m.AltText</p>
            @if (variants is not null)
            {
                <ul class="small">
                @foreach (var kv in variants)
                {
                    <li>@kv.Key: @kv.Value</li>
                }
                </ul>
            }
        </div>
    </div>
}
</div>