@model IReadOnlyList<UOM.Domain.Entities.BoardMember>
@{ ViewData["Title"] = "İl yönetimi"; }
<h1 class="h3 mb-3">İl yönetimi</h1>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni</a>
<ul class="list-group">
@foreach (var m in Model)
{
    <li class="list-group-item d-flex justify-content-between">
        <span>@m.FullName — @m.Title <small class="text-muted">@(m.ConsentOnFile ? "foto onaylı" : "foto yok")</small></span>
        <span>
            <a asp-action="Edit" asp-route-id="@m.Id">Düzenle</a>
            <partial name="_AdminDeleteForm" model="m.Id" />
        </span>
    </li>
}
</ul>