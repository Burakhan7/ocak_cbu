@model IReadOnlyList<UOM.Domain.Entities.ParentProject>
@{ ViewData["Title"] = "Projeler"; }
<h1 class="h3 mb-3">Projeler</h1>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni</a>
<ul class="list-group">
@foreach (var p in Model)
{
    <li class="list-group-item d-flex justify-content-between">
        <span>@p.Name</span>
        <a asp-action="Edit" asp-route-id="@p.Id">Düzenle</a>
    </li>
}
</ul>