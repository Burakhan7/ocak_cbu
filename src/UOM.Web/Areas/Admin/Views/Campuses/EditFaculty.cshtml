@model Faculty
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni fakülte" : "Fakülte düzenle";
    var campuses = (IReadOnlyList<Campus>)ViewBag.Campuses;
}
<form method="post" asp-action="SaveFaculty">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="Name" class="form-label">Ad</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="CampusId" class="form-label">Kampüs</label>
        <select asp-for="CampusId" class="form-select">
            @foreach (var c in campuses)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>
    <div class="mb-3"><label asp-for="Order" class="form-label">Sıra</label><input asp-for="Order" class="form-control" type="number" /></div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>