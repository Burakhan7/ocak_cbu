@model TwoFactorLoginViewModel
@{
    ViewData["Title"] = "İki faktörlü doğrulama";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Doğrulama kodu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center min-vh-100">
<div class="container" style="max-width:420px;">
    <form method="post" class="card card-body shadow-sm">
        <input type="hidden" asp-for="ReturnUrl" />
        <h1 class="h5 mb-3">Authenticator kodu</h1>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" autocomplete="one-time-code" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Doğrula</button>
    </form>
</div>
</body>
</html>